# Admin lifetime (boleh beberapa email, pisahkan dengan koma).
ADMIN_EMAIL=
# Nomor WhatsApp admin, format internasional tanpa +. Contoh: 6281234567890
WHATSAPP_NUMBER=
# Harga lifetime dalam rupiah.
LIFETIME_PRICE=49000

# Set 1 jika app diakses lewat HTTPS.
COOKIE_SECURE=0
# Lokasi database SQLite (opsional).
# DATABASE_PATH=/data/workspace/fast-track/data/app.db

# Backup otomatis SQLite (opsional).
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
# BACKUP_DIR=/data/workspace/fast-track/data/backups

# Email verifikasi (Resend). EMAIL_FROM harus memakai domain yang sudah diverifikasi di Resend.
RESEND_API_KEY=
EMAIL_FROM="fasttrack <noreply@example.com>"
# URL publik app, dipakai untuk link verifikasi di email.
APP_URL=https://domain-kamu

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Login dengan Google (opsional). Buat OAuth client di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password gate opsional (HTTP Basic Auth). Kosongkan untuk app publik.
FASTTRACK_PASSWORD=
FASTTRACK_USER=fasttrack
