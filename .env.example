# Email default untuk `npm run promote:admin`.
ADMIN_EMAIL=
# Nomor WhatsApp admin, format internasional tanpa +. Contoh: 6281234567890
WHATSAPP_NUMBER=
# Harga lifetime dalam rupiah.
LIFETIME_PRICE=49000

# Set 1 jika app diakses lewat HTTPS.
COOKIE_SECURE=0

# Email verifikasi & reset password (Resend). EMAIL_FROM harus memakai domain yang sudah diverifikasi di Resend.
RESEND_API_KEY=
EMAIL_FROM="fasttrack <noreply@example.com>"
# Secret untuk menandatangani token verifikasi/reset. Buat dengan: openssl rand -base64 48
AUTH_TOKEN_SECRET=
# URL publik app, dipakai untuk link verifikasi/reset di email.
APP_URL=https://domain-kamu

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privat untuk backup media. Default: media
SUPABASE_STORAGE_BUCKET=media
# Opsional jika Chromium tidak ada di cache Playwright.
CHROMIUM_PATH=

# Login dengan Google (opsional). Buat OAuth client di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password gate opsional (HTTP Basic Auth). Kosongkan untuk app publik.
FASTTRACK_PASSWORD=
FASTTRACK_USER=fasttrack
